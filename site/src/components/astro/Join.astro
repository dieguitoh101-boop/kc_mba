---
import { club, joinSteps } from "../../data/site";
---

<section class="join chapter--paper paper-cream chapter--edge" id="join" data-stack>
  <div class="wrap">
    <div class="join-head reveal">
      <span class="eyebrow">Come join us</span>
      <h2>Three steps to your first hour.</h2>
      <p class="join-lead">Any Mater Brickell student in grades 9 to 12 can join. No experience needed.</p>
    </div>

    <div class="contact reveal">
      <div class="meet">
        <span class="eyebrow light">Meetings</span>
        <h3>See you there.</h3>
        <p class="path">
          {joinSteps.map((st, i) => (
            <>
              <span>{st.title}</span>
              {i < joinSteps.length - 1 && <b aria-hidden="true">&rarr;</b>}
            </>
          ))}
        </p>
        <dl>
          <div><dt>When</dt><dd>{club.meetingTime}</dd></div>
          <div><dt>Where</dt><dd>{club.meetingRoom}</dd></div>
          <div><dt>Campus</dt><dd>{club.address}</dd></div>
          <div><dt>Open to</dt><dd>Grades 9 to 12</dd></div>
        </dl>
      </div>
      <div class="say">
        <span class="eyebrow">Say hello</span>
        <div class="crow">
          <div><small>Instagram</small><b id="c-ig">{club.instagram}</b></div>
          <button class="copy" type="button" data-copy="c-ig">Copy</button>
        </div>
        <div class="crow">
          <div><small>Email</small><b id="c-em">{club.email}</b></div>
          <button class="copy" type="button" data-copy="c-em">Copy</button>
        </div>
        <div class="crow">
          <div><small>Faculty advisor</small><b>{club.advisor} &middot; {club.advisorRoom}</b></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>(".copy").forEach((b) =>
    b.addEventListener("click", async () => {
      const el = document.getElementById(b.dataset.copy || "");
      if (!el) return;
      try {
        await navigator.clipboard.writeText(el.textContent || "");
        const t = b.textContent;
        b.textContent = "Copied";
        setTimeout(() => (b.textContent = t), 1400);
      } catch {
        const r = document.createRange();
        r.selectNodeContents(el);
        const s = getSelection();
        s?.removeAllRanges();
        s?.addRange(r);
      }
    })
  );
</script>

<style>
  .join { padding-block: clamp(70px, 10vw, 120px); }
  .join-head h2 {
    font-size: var(--step-3);
    line-height: 0.96;
    margin-top: 16px;
  }
  .join-lead {
    font-size: var(--step-1);
    color: var(--ink-soft);
    max-width: 46ch;
    margin-top: 18px;
  }
  .contact {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 18px;
    margin-top: clamp(34px, 5vw, 56px);
  }
  .meet {
    background: var(--navy);
    color: var(--paper);
    padding: clamp(28px, 4vw, 44px);
    border: 2px solid var(--ink);
  }
  .meet .eyebrow.light { color: var(--paper-3); }
  .meet .eyebrow.light::before { background: var(--maroon-br); }
  .meet h3 { font-size: var(--step-2); font-weight: 800; margin-top: 12px; }
  .path {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    margin-top: 16px;
    padding: 14px 0;
    border-block: 1.5px solid rgba(241, 232, 216, 0.2);
    font-family: var(--display);
    font-weight: 700;
    font-size: var(--step-0);
  }
  .path b { color: var(--gold); font-weight: 800; }
  .meet dl {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
    margin-top: 26px;
  }
  .meet dt {
    font-family: var(--display);
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--paper-3);
  }
  .meet dd { font-family: var(--display); font-weight: 700; font-size: var(--step-0); margin-top: 6px; line-height: 1.2; }
  .say {
    background: var(--paper);
    border: 2px solid var(--ink);
    padding: clamp(28px, 4vw, 44px);
  }
  .say .eyebrow { margin-bottom: 6px; }
  .crow {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 18px 0;
    border-bottom: 1.5px solid var(--line);
    flex-wrap: wrap;
  }
  .crow:last-child { border-bottom: 0; }
  .crow small {
    display: block;
    font-family: var(--display);
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--mut);
    margin-bottom: 4px;
  }
  .crow b { font-size: var(--step-0); font-weight: 700; }
  .copy {
    font-family: var(--display);
    font-weight: 700;
    font-size: var(--step--1);
    padding: 9px 15px;
    border: 2px solid var(--ink);
    background: transparent;
    transition: background 0.2s, color 0.2s;
  }
  .copy:hover { background: var(--maroon); color: var(--paper); border-color: var(--maroon); }
  @media (max-width: 820px) {
    .contact { grid-template-columns: 1fr; }
    .path {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    margin-top: 16px;
    padding: 14px 0;
    border-block: 1.5px solid rgba(241, 232, 216, 0.2);
    font-family: var(--display);
    font-weight: 700;
    font-size: var(--step-0);
  }
  .path b { color: var(--gold); font-weight: 800; }
  .meet dl { grid-template-columns: 1fr; }
  }
</style>
