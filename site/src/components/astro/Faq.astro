---
import { faq } from "../../data/site";
---

<section class="faq chapter--paper chapter--edge" id="faq" data-stack>
  <div class="wrap faq-grid">
    <aside class="reveal">
      <span class="eyebrow">Good questions</span>
      <p class="aside-lead">Still curious? Ask any officer, or send us a message.</p>
      <a class="faq-cta" href="#join">Contact us <span aria-hidden="true">&rarr;</span></a>
    </aside>
    <div class="acc">
      {faq.map((item, i) => (
        <div class={`q${i === 0 ? " open" : ""}`}>
          <button class="qb" type="button" aria-expanded={i === 0 ? "true" : "false"}>
            <span>{item.q}</span>
            <i aria-hidden="true"></i>
          </button>
          <div class="ans"><div><p>{item.a}</p></div></div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>(".faq .qb").forEach((b) =>
    b.addEventListener("click", () => {
      const q = b.parentElement!;
      const open = !q.classList.contains("open");
      document.querySelectorAll(".faq .q").forEach((x) => {
        x.classList.remove("open");
        x.querySelector(".qb")!.setAttribute("aria-expanded", "false");
      });
      if (open) {
        q.classList.add("open");
        b.setAttribute("aria-expanded", "true");
      }
    })
  );
</script>

<style>
  .faq { padding-block: clamp(70px, 10vw, 120px); }
  .faq-grid {
    display: grid;
    grid-template-columns: 0.82fr 1.18fr;
    gap: clamp(30px, 5vw, 76px);
    align-items: start;
  }
  aside { position: sticky; top: 110px; }
  .aside-lead {
    font-family: var(--display);
    font-weight: 700;
    font-size: var(--step-2);
    line-height: 1.05;
    margin-top: 18px;
  }
  .faq-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 24px;
    font-family: var(--display);
    font-weight: 700;
    font-size: var(--step--1);
    padding: 13px 22px;
    background: var(--maroon);
    color: var(--paper);
    border: 2px solid var(--maroon);
  }
  .acc { border-top: 2px solid var(--ink); }
  .q { border-bottom: 1.5px solid var(--line); }
  .qb {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    text-align: left;
    padding: 24px 4px;
    font-family: var(--display);
    font-weight: 700;
    font-size: var(--step-1);
    line-height: 1.15;
  }
  .qb i {
    position: relative;
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border: 2px solid var(--ink);
    transition: background 0.3s, color 0.3s;
  }
  .qb i::before, .qb i::after {
    content: "";
    position: absolute;
    inset: 50% 10px auto;
    height: 2px;
    background: var(--ink);
    translate: 0 -50%;
    transition: transform 0.4s var(--ease), background 0.3s;
  }
  .qb i::after { rotate: 90deg; }
  .q.open .qb i { background: var(--maroon); }
  .q.open .qb i::before, .q.open .qb i::after { background: var(--paper); }
  .q.open .qb i::after { transform: scaleX(0); }
  .ans {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.45s var(--ease);
  }
  .q.open .ans { grid-template-rows: 1fr; }
  .ans > div { overflow: hidden; }
  .ans p {
    padding: 0 4px 26px;
    color: var(--ink-soft);
    font-size: var(--step-0);
    max-width: 62ch;
  }
  @media (max-width: 820px) {
    .faq-grid { grid-template-columns: 1fr; }
    aside { position: static; }
  }
</style>
