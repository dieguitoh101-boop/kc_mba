---
import { faq } from "../../data/site";
---

<section class="faq chapter--paper paper-2 chapter--edge" id="faq" data-stack>
  <div class="wrap">
    <h2 class="reveal">Good questions.</h2>
    <dl class="qa">
      {faq.map((item) => (
        <div class="qa-item reveal">
          <dt>{item.q}</dt>
          <dd>{item.a}</dd>
        </div>
      ))}
    </dl>
    <p class="still reveal">
      Still curious? Ask any officer, or send us a message.
      <a class="faq-cta" href="#join">Contact us <span aria-hidden="true">&rarr;</span></a>
    </p>
  </div>
</section>

<style>
  .faq { padding-block: clamp(70px, 10vw, 120px); }
  .faq h2 {
    font-size: var(--step-3);
    line-height: 0.96;
  }
  .qa {
    column-count: 2;
    column-gap: clamp(30px, 5vw, 72px);
    column-rule: 1.5px solid var(--line);
    margin-top: clamp(30px, 4vw, 48px);
    padding-top: 26px;
    border-top: 2px solid var(--ink);
  }
  .qa-item {
    break-inside: avoid;
    padding-bottom: 28px;
  }
  .qa dt {
    font-family: var(--display);
    font-weight: 800;
    font-size: var(--step-1);
    line-height: 1.15;
  }
  .qa dd {
    margin-top: 8px;
    color: var(--ink-soft);
    font-size: var(--step-0);
    line-height: 1.45;
    max-width: 52ch;
  }
  .still {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px 22px;
    margin-top: 10px;
    padding-top: 24px;
    border-top: 1.5px solid var(--line);
    font-family: var(--display);
    font-weight: 700;
    font-size: var(--step-1);
  }
  .faq-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--display);
    font-weight: 700;
    font-size: var(--step--1);
    padding: 13px 22px;
    background: var(--maroon);
    color: var(--paper);
    border: 2px solid var(--maroon);
  }
  @media (max-width: 760px) {
    .qa { column-count: 1; }
  }
</style>
