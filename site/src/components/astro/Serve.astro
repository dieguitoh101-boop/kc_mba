---
import { causes } from "../../data/site";
const features = [
  { ...causes[0], photo: "/img/stock-env.jpg", cls: "ft1" },
  { ...causes[1], photo: "/img/stock-hunger.jpg", cls: "ft2" },
];
const rest = causes.slice(2);
---

<section class="serve chapter--paper paper-2 chapter--edge" id="serve" data-stack>
  <div class="wrap">
    <div class="serve-head reveal">
      <h2>Six ways we show up.</h2>
    </div>

    <div class="spread">
      <div class="features">
        {features.map((c) => (
          <figure class={`feat ${c.cls} reveal`} data-tilt data-cursor={c.title}>
            <img src={c.photo} alt={`Key Club ${c.title.toLowerCase()} work`} loading="lazy" />
            <figcaption>
              <span class="cn">{c.n}</span>
              <h3>{c.title}</h3>
              <p>{c.body}</p>
            </figcaption>
          </figure>
        ))}
      </div>

      <div class="also reveal">
        <span class="tape">Also on the list</span>
        <ol>
          {rest.map((c) => (
            <li>
              <span class="cn">{c.n}</span>
              <div>
                <h3>{c.title}</h3>
                <p>{c.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .serve { padding-block: clamp(70px, 10vw, 120px); }
  .serve-head h2 {
    font-size: var(--step-3);
    line-height: 0.96;
    margin-top: 0;
  }

  .spread {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
    margin-top: clamp(28px, 4vw, 52px);
  }
  .features {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(18px, 2.4vw, 32px);
    perspective: 1000px;
  }
  .feat {
    position: relative;
    margin: 0;
    background: var(--paper);
    border: 1.5px solid var(--ink);
    padding: 10px 10px 18px;
    box-shadow: 8px 10px 0 var(--ink);
    transform-style: preserve-3d;
    transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease);
  }
  .feat::before {
    content: "";
    position: absolute;
    top: -14px;
    left: 50%;
    width: 96px;
    height: 28px;
    translate: -50% 0;
    rotate: -3deg;
    background: color-mix(in srgb, var(--paper-3) 70%, transparent);
    border: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
    z-index: 2;
  }
  .ft1 { rotate: -2deg; }
  .ft2 { rotate: 2.4deg; margin-top: clamp(28px, 5vw, 70px); }
  .ft2::before { rotate: 4deg; left: 38%; }
  .feat img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: grayscale(0.15) contrast(1.05);
  }
  .feat figcaption { padding: 14px 4px 0; }
  .cn {
    font-family: var(--display);
    font-weight: 800;
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    color: var(--maroon);
  }
  .feat h3 { font-size: var(--step-1); font-weight: 800; line-height: 1; margin-top: 4px; }
  .feat p { margin-top: 8px; font-size: var(--step--1); line-height: 1.4; color: var(--ink-soft); }

  .also .tape { display: inline-block; rotate: -1.5deg; background: var(--paper); }
  .also ol { margin-top: 18px; border-top: 2px solid var(--ink); }
  .also li {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 12px;
    padding-block: 18px;
    border-bottom: 1.5px solid color-mix(in srgb, var(--ink) 30%, transparent);
  }
  .also li .cn { font-size: var(--step-1); line-height: 1; }
  .also h3 { font-size: var(--step-0); font-weight: 800; line-height: 1.1; }
  .also p { margin-top: 4px; font-size: var(--step--1); line-height: 1.4; color: var(--ink-soft); max-width: 40ch; }

  @media (max-width: 900px) {
    .spread { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .features { grid-template-columns: 1fr; }
    .ft2 { margin-top: 10px; }
  }
</style>
