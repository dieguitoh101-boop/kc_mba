---
import { club } from "../../data/site";
const links = [
  { href: "#home", label: "Home" },
  { href: "#about", label: "Who we are" },
  { href: "#impact", label: "Impact" },
  { href: "#serve", label: "What we do" },
  { href: "#events", label: "Events" },
  { href: "#join", label: "Join & contact" },
  { href: "#faq", label: "Questions" },
];
---

<a class="lockup" href="#home" aria-label="Mater Brickell Key Club home">
  <img class="seal-kc" src="/img/seal-keyclub.png" alt="" aria-hidden="true" />
  <img class="seal-mba" src="/img/crest-mba.png" alt="" aria-hidden="true" />
</a>

<button class="menu-btn" id="menuOpen" type="button" aria-expanded="false" aria-controls="menu" aria-label="Open menu">
  <span class="mb-dots" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
  <span class="mb-word">Menu</span>
</button>

<div class="menu" id="menu" aria-hidden="true">
  <button class="menu-x" id="menuClose" type="button">Close</button>
  <div class="menu-grid">
    <nav class="menu-nav" aria-label="Pages">
      <ol>
        {links.map((l, i) => (
          <li>
            <a href={l.href}>
              <span class="mn-i">{String(i + 1).padStart(2, "0")}</span>
              <span class="mn-l">{l.label}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
    <aside class="menu-side">
      <div class="seals">
        <img src="/img/crest-mba.png" alt="Mater Brickell Academy crest" />
        <img src="/img/seal-keyclub.png" alt="Key Club International seal" />
      </div>
      <p class="menu-motto">Caring is our <em>way of life.</em></p>
      <ul class="menu-tapes">
        <li>Serve</li><li>Lead</li><li>Care</li>
      </ul>
      <dl class="menu-meta">
        <div><dt>Find us</dt><dd>{club.address}</dd></div>
        <div><dt>Instagram</dt><dd>{club.instagram}</dd></div>
      </dl>
    </aside>
  </div>
</div>

<script>
  const openB = document.getElementById("menuOpen");
  const closeB = document.getElementById("menuClose");
  const menu = document.getElementById("menu");
  function set(open: boolean) {
    if (!menu || !openB) return;
    menu.classList.toggle("is-open", open);
    menu.setAttribute("aria-hidden", String(!open));
    openB.setAttribute("aria-expanded", String(open));
    document.documentElement.style.overflow = open ? "hidden" : "";
  }
  openB?.addEventListener("click", () => set(true));
  closeB?.addEventListener("click", () => set(false));
  menu?.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) set(false);
  });
  addEventListener("keydown", (e) => {
    if (e.key === "Escape") set(false);
  });
</script>

<style>
  .lockup {
    position: fixed;
    top: calc(env(safe-area-inset-top, 0px) + 16px);
    left: clamp(14px, 3vw, 28px);
    z-index: 55;
    width: 96px;
    height: 56px;
  }
  .lockup img {
    position: absolute;
    top: 0;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--paper);
    box-shadow: 0 6px 16px -8px rgba(30, 47, 87, 0.7);
    transition: transform 0.4s var(--ease);
  }
  .seal-kc { left: 36px; background: #fff; }
  .seal-mba { left: 0; z-index: 2; background: var(--navy); }
  .lockup:hover .seal-mba { transform: translateX(-4px) rotate(-6deg); }
  .lockup:hover .seal-kc { transform: translateX(6px) rotate(6deg); }

  .menu-btn {
    position: fixed;
    top: calc(env(safe-area-inset-top, 0px) + 16px);
    right: clamp(14px, 3vw, 28px);
    z-index: 55;
    display: inline-flex;
    align-items: center;
    gap: 11px;
    padding: 13px 24px 13px 17px;
    border-radius: 999px;
    background: var(--maroon);
    color: var(--paper);
    border: 2px solid var(--ink);
    font-family: var(--display);
    font-weight: 800;
    font-size: var(--step-0);
    letter-spacing: 0.01em;
    box-shadow: 0 12px 26px -12px rgba(146, 21, 25, 0.9);
    transition: transform 0.3s var(--ease), background 0.3s, border-color 0.3s;
    animation: mb-pulse 2.8s ease-in-out infinite;
  }
  .menu-btn:hover {
    transform: translateY(-2px) rotate(-1.5deg);
    background: var(--ink);
    border-color: var(--gold);
  }
  .mb-dots {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3px;
    width: 18px;
    height: 18px;
    transition: transform 0.5s var(--ease);
  }
  .mb-dots i {
    width: 100%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--gold);
  }
  .menu-btn:hover .mb-dots { transform: rotate(90deg) scale(1.08); }
  @keyframes mb-pulse {
    0%, 100% { box-shadow: 0 12px 26px -12px rgba(146, 21, 25, 0.9), 0 0 0 0 rgba(146, 21, 25, 0.45); }
    50% { box-shadow: 0 12px 26px -12px rgba(146, 21, 25, 0.9), 0 0 0 11px rgba(146, 21, 25, 0); }
  }
  @media (prefers-reduced-motion: reduce) { .menu-btn { animation: none; } }

  .menu {
    position: fixed;
    inset: 0;
    z-index: 60;
    background-color: var(--navy);
    background-image:
      radial-gradient(38% 46% at 82% 22%, rgba(198, 162, 74, 0.14), transparent 70%),
      radial-gradient(42% 50% at 12% 82%, rgba(192, 10, 45, 0.16), transparent 70%),
      radial-gradient(rgba(8, 13, 28, 0.45) 1.5px, transparent 1.9px);
    background-size: 100% 100%, 100% 100%, 22px 22px;
    color: var(--paper);
    visibility: hidden;
    clip-path: circle(0% at calc(100% - 46px) 46px);
    transition: clip-path 0.7s var(--ease), visibility 0s linear 0.7s;
  }
  .menu.is-open {
    visibility: visible;
    clip-path: circle(150% at calc(100% - 46px) 46px);
    transition: clip-path 0.8s var(--ease);
  }
  .menu-x {
    position: absolute;
    top: calc(env(safe-area-inset-top, 0px) + 22px);
    right: clamp(14px, 3vw, 28px);
    z-index: 2;
    padding: 11px 18px;
    border-radius: 999px;
    border: 1.5px solid rgba(241, 232, 216, 0.4);
    color: var(--paper);
    font-family: var(--display);
    font-weight: 700;
    font-size: var(--step--1);
  }
  .menu-x:hover { background: var(--maroon); border-color: var(--maroon); }
  .menu-grid {
    height: 100%;
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: clamp(24px, 5vw, 70px);
    padding: clamp(90px, 12vh, 140px) clamp(20px, 6vw, 80px) clamp(30px, 5vh, 60px);
    align-content: center;
    max-width: 1280px;
    margin-inline: auto;
  }
  .menu-nav ol { counter-reset: m; }
  .menu-nav li { overflow: hidden; }
  .menu-nav a {
    display: flex;
    align-items: baseline;
    gap: clamp(14px, 2vw, 26px);
    padding: clamp(6px, 1vw, 12px) 0;
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(34px, 6vw, 76px);
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: var(--paper);
    transition: color 0.25s, padding-left 0.3s var(--ease);
  }
  .menu-nav a:hover { color: var(--gold); padding-left: 14px; }
  .mn-i {
    font-family: var(--display);
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--gold);
    letter-spacing: 0.1em;
  }
  .menu-side {
    display: grid;
    align-content: center;
    gap: clamp(18px, 3vh, 30px);
    border-left: 1.5px solid rgba(241, 232, 216, 0.18);
    padding-left: clamp(20px, 3vw, 44px);
  }
  .seals { display: flex; gap: 14px; }
  .seals img {
    width: clamp(56px, 7vw, 84px);
    height: clamp(56px, 7vw, 84px);
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid rgba(241, 232, 216, 0.6);
  }
  .seals img:first-child { background: var(--navy); }
  .seals img:last-child { background: #fff; }
  .menu-motto {
    font-family: var(--display);
    font-weight: 800;
    font-size: var(--step-2);
    line-height: 1.02;
  }
  .menu-motto em { font-style: italic; color: var(--gold); }
  .menu-tapes { display: flex; gap: 10px; }
  .menu-tapes li {
    font-family: var(--display);
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border: 1.5px solid var(--gold);
    color: var(--gold);
    padding: 5px 10px;
  }
  .menu-meta { display: grid; gap: 16px; }
  .menu-meta dt {
    font-family: var(--display);
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold-soft);
  }
  .menu-meta dd { margin-top: 4px; font-size: var(--step--1); color: var(--paper); }

  @media (max-width: 820px) {
    .menu-grid { grid-template-columns: 1fr; align-content: start; gap: 30px; }
    .menu-side { border-left: 0; padding-left: 0; border-top: 1.5px solid rgba(241, 232, 216, 0.18); padding-top: 24px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu { transition: visibility 0s; }
    .menu.is-open { transition: visibility 0s; }
  }
</style>
