---
import { stats } from "../../data/site";
const fills = [100, 40, 88, 66];
const data = stats.map((s, i) => ({ ...s, fill: fills[i] }));
---

<section class="impact dark-tex" id="impact" data-stack>
  <div class="wrap">
    <span class="eyebrow light">By the numbers</span>
    <h2>Part of something <em>much bigger.</em></h2>
    <div class="nums" id="nums">
      {data.map((s) => (
        <div class="tile">
          <b class="val" data-to={s.value}>0</b>
          <span class="meter"><i style={`--to:${s.fill}%`}></i></span>
          <span class="lab">{s.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const scope = document.getElementById("nums");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  function run() {
    scope?.querySelectorAll<HTMLElement>(".tile").forEach((tile) => {
      const el = tile.querySelector<HTMLElement>(".val");
      const bar = tile.querySelector<HTMLElement>(".meter i");
      if (bar) bar.style.width = getComputedStyle(bar).getPropertyValue("--to");
      if (!el) return;
      const raw = el.getAttribute("data-to") || "";
      const m = raw.match(/^(\d+)(.*)$/);
      if (!m) { el.textContent = raw; return; }
      const target = +m[1];
      const suffix = m[2];
      if (reduce) { el.textContent = String(target) + suffix; return; }
      const dur = 1700;
      let start: number | null = null;
      const step = (ts: number) => {
        if (start === null) start = ts;
        const p = Math.min(1, (ts - start) / dur);
        const eased = 1 - Math.pow(1 - p, 4);
        el.textContent = String(Math.round(target * eased)) + suffix;
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    });
  }
  if (scope) {
    const io = new IntersectionObserver(
      (ents) => ents.forEach((e) => { if (e.isIntersecting) { io.disconnect(); run(); } }),
      { threshold: 0.35 }
    );
    io.observe(scope);
  }
</script>

<style>
  .impact {
    color: var(--paper);
    padding-block: clamp(80px, 11vw, 130px);
    border-block: 2px solid var(--ink);
  }
  .eyebrow.light { color: var(--gold-soft); }
  .eyebrow.light::before { background: var(--gold); }
  .impact h2 {
    font-size: var(--step-3);
    line-height: 0.96;
    max-width: 16ch;
    margin-top: 16px;
  }
  .impact h2 em { font-style: italic; color: var(--gold); }
  .nums {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: clamp(44px, 7vh, 80px);
    border-top: 2px solid var(--gold);
  }
  .tile {
    padding: 26px clamp(16px, 2vw, 28px) 0 0;
    border-right: 1.5px solid rgba(241, 232, 216, 0.16);
  }
  .tile:last-child { border-right: 0; }
  .tile .val {
    display: block;
    font-family: var(--display);
    font-weight: 800;
    font-size: var(--step-4);
    line-height: 0.9;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    color: var(--gold);
  }
  .meter {
    display: block;
    height: 5px;
    margin-top: 18px;
    background: rgba(241, 232, 216, 0.16);
    overflow: hidden;
  }
  .meter i {
    display: block;
    height: 100%;
    width: 0;
    background: var(--maroon-br);
    transition: width 1.5s var(--ease);
  }
  .lab {
    display: block;
    margin-top: 16px;
    color: var(--paper-3);
    font-size: var(--step--1);
    max-width: 22ch;
    min-height: 3.2em;
  }
  @media (max-width: 760px) {
    .nums { grid-template-columns: 1fr 1fr; }
    .tile {
      padding: 24px 16px 20px 0;
      border-right: 0;
      border-bottom: 1.5px solid rgba(241, 232, 216, 0.16);
    }
    .tile:nth-child(odd) { border-right: 1.5px solid rgba(241, 232, 216, 0.16); }
    .lab { min-height: 0; }
  }
</style>
