---
import { club, photos } from "../../data/site";
---

<section class="hero" id="home" data-stack>
  <div class="wrap hero-grid">
    <div class="ledger">
      <span>{club.school} &middot; {club.city}</span>
      <span class="ledger-mid dots" aria-hidden="true"></span>
      <span>Est. service &middot; 305</span>
    </div>

    <div class="hero-head">
      <p class="kick">Vol. 01 &mdash; The service issue</p>
      <h1>
        <span class="l1">Caring</span>
        <span class="l2">is our</span>
        <span class="l3">way of <em>life.</em></span>
      </h1>
    </div>

    <div class="hero-photo">
      <figure class="photo-card" data-tilt data-cursor="Our crew">
        <span class="pin pin-a" aria-hidden="true"></span>
        <span class="pin pin-b" aria-hidden="true"></span>
        <img src={photos[0].src} alt="Mater Brickell Key Club members together" loading="eager" />
        <figcaption>{photos[0].label}</figcaption>
      </figure>
    </div>

    <div class="hero-side">
      <p class="lead">
        The student-led service club at Mater Brickell. We clean up Biscayne Bay,
        feed our neighbors, tutor younger kids and make lifelong friends doing it.
      </p>
      <div class="btns">
        <a class="btn btn-solid" href="#join">Become a member <span aria-hidden="true">&rarr;</span></a>
        <a class="btn btn-line" href="#events">Upcoming service <span aria-hidden="true">&rarr;</span></a>
      </div>
      <ul class="tapes">
        <li class="tape">Serve</li>
        <li class="tape">Lead</li>
        <li class="tape">Care</li>
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(92px, 11vh, 124px) clamp(44px, 6vw, 72px);
    border-bottom: 2px solid var(--ink);
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.58fr 0.92fr;
    grid-template-areas:
      "ledger ledger"
      "head   head"
      "side   photo";
    column-gap: clamp(20px, 4vw, 64px);
    row-gap: clamp(26px, 4vw, 52px);
    align-items: end;
  }

  .ledger {
    grid-area: ledger;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 16px;
    font-family: var(--display);
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    padding-bottom: 14px;
    border-bottom: 1.5px solid var(--line);
    margin-bottom: clamp(20px, 4vw, 48px);
  }
  .ledger-mid { height: 7px; align-self: center; opacity: 0.8; }

  .hero-head { grid-area: head; }
  .kick {
    font-family: var(--display);
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--maroon);
    margin-bottom: clamp(10px, 1.5vw, 18px);
  }
  h1 {
    font-size: var(--step-5);
    line-height: 0.82;
    letter-spacing: -0.035em;
    text-transform: uppercase;
  }
  h1 span { display: block; }
  .l2 { padding-left: 0.12em; }
  .l3 { margin-top: 0.02em; }
  h1 em {
    font-style: italic;
    font-weight: 700;
    color: var(--maroon);
  }

  .hero-photo {
    grid-area: photo;
    justify-self: end;
    width: min(100%, 330px);
    perspective: 900px;
  }
  .photo-card {
    position: relative;
    margin: 0;
    rotate: 3.2deg;
    background: var(--paper);
    padding: 12px 12px 42px;
    border: 1.5px solid var(--ink);
    box-shadow: 10px 14px 0 var(--ink);
    transform-style: preserve-3d;
    transition: transform 0.4s var(--ease);
  }
  .photo-card img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: grayscale(0.25) contrast(1.06) saturate(0.92);
  }
  .photo-card figcaption {
    position: absolute;
    left: 14px;
    bottom: 12px;
    font-family: var(--display);
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .pin {
    position: absolute;
    top: -12px;
    width: 68px;
    height: 24px;
    background: color-mix(in srgb, var(--maroon) 86%, transparent);
    mix-blend-mode: multiply;
    rotate: -6deg;
  }
  .pin-a { left: 22px; }
  .pin-b { right: 22px; rotate: 7deg; width: 56px; }

  .hero-side { grid-area: side; display: grid; gap: clamp(20px, 2.6vw, 30px); max-width: 44ch; }
  .lead {
    font-size: var(--step-1);
    line-height: 1.35;
    color: var(--ink-soft);
    font-weight: 500;
  }

  .btns { display: flex; flex-wrap: wrap; gap: 12px; }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--display);
    font-weight: 700;
    font-size: var(--step--1);
    letter-spacing: 0.02em;
    padding: 14px 24px;
    border: 2px solid var(--ink);
    transition: transform 0.25s var(--ease), background 0.25s, color 0.25s;
  }
  .btn span { transition: transform 0.25s var(--ease); }
  .btn:hover span { transform: translateX(4px); }
  .btn-solid { background: var(--maroon); color: var(--paper); border-color: var(--maroon); }
  .btn-solid:hover { background: var(--ink); border-color: var(--ink); }
  .btn-line { background: transparent; color: var(--ink); box-shadow: 4px 4px 0 var(--ink); }
  .btn-line:hover { transform: translate(2px, 2px); box-shadow: 2px 2px 0 var(--ink); }

  .tapes { display: flex; flex-wrap: wrap; gap: 10px; }

  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
      grid-template-areas:
        "ledger"
        "head"
        "photo"
        "side";
      align-items: start;
    }
    .hero-photo { justify-self: start; margin-top: 10px; }
    .photo-card { rotate: -2.5deg; }
  }
</style>
